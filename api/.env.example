# ── Database (Railway injects DATABASE_URL automatically when you add a Postgres plugin) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolos?schema=public"

# ── Server ──
PORT=4000
NODE_ENV=development
# Comma separated. Supports wildcard subdomains, e.g. https://*.schoolos.app
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# ── Auth (use long random strings in production: openssl rand -hex 48) ──
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Platform bootstrap: created on first start if no platform admin exists ──
PLATFORM_ADMIN_EMAIL=admin@schoolos.app
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_ADMIN_NAME=Platform Owner

# ── Multi-tenant domains ──
# Root domain that school subdomains hang off (school-slug.ROOT_DOMAIN). Vercel wildcard domain.
ROOT_DOMAIN=schoolos.app
# When true, newly registered schools are ACTIVE immediately (self-serve). When false they wait for platform approval.
PLATFORM_AUTO_APPROVE=false
# Public URL of the web app (used in links)
WEB_APP_URL=http://localhost:3000

# ── Payments (Paystack). Schools may also set their own keys under Settings → Finance ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── SMS provider: LOG (prints to console) or ARKESEL ──
SMS_PROVIDER=LOG
SMS_API_KEY=
SMS_SENDER_ID=SchoolOS

# ── Email: LOG or SMTP ──
EMAIL_PROVIDER=LOG
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="School OS <no-reply@schoolos.app>"

# ── Misc ──
PRISMA_LOG=false
# Set to true when the database requires TLS (Railway public proxy URL, Neon, Supabase). The private Railway URL does not.
DATABASE_SSL=false
# Non-superuser role the API switches to on every connection so Row-Level Security is binding (created by the RLS migration)
DB_APP_ROLE=schoolos_app
DB_SKIP_SET_ROLE=false
DB_POOL_MAX=10
# Bank / Mobile Money details shown to schools when they request a plan change
PLATFORM_BANK_DETAILS=
# Set SWAGGER=false to hide the interactive API docs at /docs
SWAGGER=true
# DEV ONLY (sandboxes that cannot download Prisma's native engine). Never set this in production.
# PRISMA_ENGINE=wasm
