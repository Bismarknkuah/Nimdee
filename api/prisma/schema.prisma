}

// ─────────────────────────── Events & calendar ───────────────────────────
enum EventType {
  ACADEMIC
  HOLIDAY
  EXAM
  MEETING
  SPORTS
  CULTURAL
  TRIP
  OTHER
}

model SchoolEvent {
  id           String       @id @default(uuid())
