// ─────────────────────────── Assignments / homework ───────────────────────────
enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}
enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  MISSING
}

model Assignment {
  id           String                 @id @default(uuid())
  tenantId     String
  classId      String
  class        SchoolClass            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId    String?
  title        String
  instructions String
  dueAt        DateTime
  maxScore     Decimal?               @db.Decimal(8, 2)
  status       AssignmentStatus       @default(PUBLISHED)
  attachments  Json?
  createdById  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  submissions  AssignmentSubmission[]

  @@index([tenantId, classId, dueAt])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  tenantId     String
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  score        Decimal?         @db.Decimal(8, 2)
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
}

// ─────────────────────────── Library ───────────────────────────
enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
}

model LibraryBook {
  id              String        @id @default(uuid())
  tenantId        String
  isbn            String?
  title           String
  author          String
  category        String        @default("GENERAL")
  publisher       String?
  year            Int?
  copiesTotal     Int           @default(1)
  copiesAvailable Int           @default(1)
  location        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  loans           LibraryLoan[]

  @@index([tenantId, title])
}

model LibraryLoan {
  id         String      @id @default(uuid())
  tenantId   String
  bookId     String
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  borrowedAt DateTime    @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     LoanStatus  @default(BORROWED)
  fine       Decimal     @default(0) @db.Decimal(12, 2)
  finePaid   Boolean     @default(false)
  notes      String?
  issuedById String?

  @@index([tenantId, status])
  @@index([tenantId, studentId])
}

// ─────────────────────────── Transport ───────────────────────────
model TransportRoute {
  id          String                @id @default(uuid())
  tenantId    String
  name        String
  description String?
  vehicle     String?
  driverName  String?
  driverPhone String?
  capacity    Int?
  termFee     Decimal?              @db.Decimal(12, 2)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  stops       TransportStop[]
  assignments TransportAssignment[]

  @@index([tenantId])
}

model TransportStop {
  id          String                @id @default(uuid())
  tenantId    String
  routeId     String
  route       TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name        String
  sequence    Int                   @default(1)
  pickupTime  String?
  dropoffTime String?
  assignments TransportAssignment[]

  @@index([tenantId, routeId])
}

model TransportAssignment {
  id        String         @id @default(uuid())
  tenantId  String
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId    String?
  stop      TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  studentId String         @unique
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate DateTime       @db.Date
  endDate   DateTime?      @db.Date
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([tenantId, routeId])
}

// ─────────────────────────── Health ───────────────────────────
enum HealthVisitType {
  SICK_BAY
  INJURY
  CHECKUP
  MEDICATION
  EMERGENCY
  OTHER
}

model HealthRecord {
  id                String   @id @default(uuid())
  tenantId          String
  studentId         String   @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup        String?
  allergies         String?
  conditions        String?
  medications       String?
  immunizations     Json?
  doctorName        String?
  doctorPhone       String?
  insuranceProvider String?
  insuranceNumber   String?
  notes             String?
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model HealthVisit {
  id             String          @id @default(uuid())
  tenantId       String
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime        @default(now())
  type           HealthVisitType @default(SICK_BAY)
  complaint      String
  treatment      String?
  temperature    Decimal?        @db.Decimal(4, 1)
  referredOut    Boolean         @default(false)
  parentNotified Boolean         @default(false)
  recordedById   String?
  notes          String?
