// ═══════════════════════════════ CANTEEN & INVENTORY ═══════════════════════════════

model CanteenItem {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  category  String          @default("FOOD")
  price     Decimal         @db.Decimal(10, 2)
  stock     Int             @default(0)
  minStock  Int             @default(0)
  unit      String          @default("unit")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  movements StockMovement[]

  @@unique([tenantId, name])
  planItems   CanteenPlanItem[]
}

model Wallet {
  id           String              @id @default(uuid())
  tenantId     String
  studentId    String              @unique
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  balance         Decimal             @default(0) @db.Decimal(12, 2)
  dailyLimit      Decimal?            @db.Decimal(12, 2)
  /// Allows the balance to go negative down to -creditLimit (post-paid / credit canteen plans)
  creditLimit     Decimal?            @db.Decimal(12, 2)
  lastAllowanceAt DateTime?
  isActive        Boolean             @default(true)
  updatedAt       DateTime            @updatedAt
  transactions    WalletTransaction[]
}

enum WalletTxType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
  ALLOWANCE
  SUBSCRIPTION
}

model WalletTransaction {
  id           String       @id @default(uuid())
  tenantId     String
  walletId     String
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTxType
  amount       Decimal      @db.Decimal(12, 2)
  balanceAfter Decimal      @db.Decimal(12, 2)
  reference    String?
  saleId       String?
  method       String?
  byId         String?
  createdAt    DateTime     @default(now())

  @@index([tenantId, walletId, createdAt])
}

enum SalePaymentMode {
  WALLET
  CASH
  MEAL_PLAN
  CREDIT
}

model CanteenSale {
  id            String          @id @default(uuid())
  tenantId      String
  studentId     String?
  cashierId     String?
  items         Json
  total         Decimal         @db.Decimal(12, 2)
  /// Portion of the total covered by the student's meal plan (not charged to wallet/cash)
  coveredAmount Decimal         @default(0) @db.Decimal(12, 2)
  mealCount     Int             @default(0)
  planId        String?
  paymentMode   SalePaymentMode
  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, studentId, createdAt])
}

// ───────────────────────── Canteen payment structures ─────────────────────────
/// How a school lets its students pay for the canteen. Every school configures its own plans.
enum CanteenPlanType {
  PREPAID
  PAY_AS_YOU_GO
  MEAL_PLAN
  CREDIT
  ALLOWANCE
}

enum CanteenBillingPeriod {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  TERM
}

enum PlanEnrolmentStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

model CanteenPlan {
  id                 String               @id @default(uuid())
  tenantId           String
  code               String
  name               String
  description        String?
  type               CanteenPlanType
  /// Price per billing period (meal plans / subscriptions); 0 for wallet-based plans
  price              Decimal              @default(0) @db.Decimal(12, 2)
  billingPeriod      CanteenBillingPeriod @default(NONE)
  /// Meal plans: meals covered per school day
  mealsPerDay        Int                  @default(1)
  dailyLimit         Decimal?             @db.Decimal(12, 2)
  /// Credit plans: how far the wallet may go negative before purchases are refused
  creditLimit        Decimal?             @db.Decimal(12, 2)
  /// Allowance plans: amount credited to the wallet automatically
  allowanceAmount    Decimal?             @db.Decimal(12, 2)
  allowanceFrequency CanteenBillingPeriod @default(NONE)
  /// Bill the plan price through the school's fee invoices (Canteen fee category)
  billToFees         Boolean              @default(true)
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  items              CanteenPlanItem[]
  enrolments         StudentCanteenPlan[]
  feedingCharges     CanteenFeedingCharge[]

  @@unique([tenantId, code])
}

/// Menu items covered by a meal plan
model CanteenPlanItem {
  id       String      @id @default(uuid())
  tenantId String
  planId   String
  plan     CanteenPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId   String
  item     CanteenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([planId, itemId])
}

model StudentCanteenPlan {
  id          String              @id @default(uuid())
  tenantId    String
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId      String
  plan        CanteenPlan         @relation(fields: [planId], references: [id])
  termId      String?
  status      PlanEnrolmentStatus @default(ACTIVE)
  startDate   DateTime            @db.Date
  endDate     DateTime?           @db.Date
  /// Fee invoice that billed this enrolment (meal plans billed to fees)
  invoiceId   String?
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId, studentId, status])
  @@index([tenantId, planId])
}

enum FeedingPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  TERMLY
}

/// One recorded feeding payment for a specific stretch of school days, at the plan's daily rate.
/// Prevents double-charging by checking for date overlap with existing charges for the same student
/// and plan before a new one is recorded.
model CanteenFeedingCharge {
  id           String            @id @default(uuid())
  tenantId     String
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId       String
  plan         CanteenPlan       @relation(fields: [planId], references: [id])
  periodType   FeedingPeriodType
  periodStart  DateTime          @db.Date
  periodEnd    DateTime          @db.Date
  schoolDays   Int
  dailyRate    Decimal           @db.Decimal(12, 2)
  amount       Decimal           @db.Decimal(12, 2)
  billedToFees Boolean           @default(true)
  invoiceId    String?
  recordedById String?
  createdAt    DateTime          @default(now())

  @@index([tenantId, studentId, periodStart])
  @@index([tenantId, planId])
}

enum StockMoveType {
  IN
  OUT
  ADJUST
  WASTE
}

model StockMovement {
  id        String        @id @default(uuid())
  tenantId  String
  itemId    String
  item      CanteenItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      StockMoveType
  quantity  Int
  reason    String?
  refId     String?
  byId      String?
  createdAt DateTime      @default(now())

  @@index([tenantId, itemId])
}

model InventoryItem {
  id          String              @id @default(uuid())
  tenantId    String
  name        String
  category    String              @default("GENERAL")
  quantity    Int                 @default(0)
  minQuantity Int                 @default(0)
  unit        String              @default("unit")
  location    String?
  unitCost    Decimal?            @db.Decimal(12, 2)
  supplier    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   InventoryMovement[]

  @@unique([tenantId, name])
}

model InventoryMovement {
  id        String        @id @default(uuid())
  tenantId  String
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      StockMoveType
  quantity  Int
  reason    String?
  byId      String?
  createdAt DateTime      @default(now())

  @@index([tenantId, itemId])
}

// ═══════════════════════════════ COMMUNICATION ═══════════════════════════════

enum AudienceType {
  ALL
  PARENTS
  TEACHERS
  STAFF
  STUDENTS
  CLASS
}

model Announcement {
  id           String       @id @default(uuid())
  tenantId     String
  title        String
  body         String
  audienceType AudienceType @default(ALL)
  classId      String?
  channels     String[]
  isPublic     Boolean      @default(false)
  createdById  String?
  publishedAt  DateTime?
  recipients   Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([tenantId, publishedAt])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  body      String
  type      String    @default("GENERAL")
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
}

// ───────────────────────── Data ownership: exports & backups ─────────────────────────
enum ExportFormat {
  JSON
  CSV
  SQL
}

/// History of full-data downloads (schools own their data; every export is recorded and audited)
model DataExport {
  id            String       @id @default(uuid())
  tenantId      String
  requestedById String?
  requestedBy   String?
  format        ExportFormat
  fileName      String
  sizeBytes     Int          @default(0)
  rowCount      Int          @default(0)
  tables        Int          @default(0)
  durationMs    Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String?
  userId    String
  actorType String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────── Discipline ───────────────────────────
