  MINOR
  MODERATE
  SERIOUS
}
enum DisciplineStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model DisciplineIncident {
  id             String             @id @default(uuid())
  tenantId       String
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
